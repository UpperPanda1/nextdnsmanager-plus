<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground: a shield (DNS protection) with a "+" (the "+" of NextDNS Manager+) cut out of it.
    Drawn in a 24-unit square, scaled 2.5 x to 60 dp and centred in the 108 dp canvas, so it stays inside the
    66 dp "safe zone" every launcher shape keeps visible. fillType evenOdd makes the "+" a hole, so the background
    colour (or the themed-icon colour) shows through. Shield: Material Icons "shield" (Apache License 2.0).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12 5.16,-1.26 9,-6.45 9,-12V5l-9,-4zM11,7.5h2v3h3v2h-3v3h-2v-3H8v-2h3z" />
    </group>
</vector>
