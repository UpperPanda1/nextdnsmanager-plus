<?xml version="1.0" encoding="utf-8"?>
<!--
    Texts of the NATIVE parts (top bar, menus, lock screen, messages). The Settings and About screens
    are HTML pages with their texts inside (assets/settings.html, assets/about.html).
    Everything that names the DNS service lives in site/Site.java, not here.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Used by app/build.gradle (manifestPlaceholders), which lint can't see. -->
    <string name="app_name" tools:ignore="UnusedResources">NextDNS Manager+</string>

    <!-- Top bar -->
    <string name="switch_account">Switch account</string>
    <string name="dropdown_arrow" translatable="false">▾</string>
    <string name="home">Dashboard home</string>
    <string name="more_options">More options</string>

    <!-- Three-dots menu -->
    <string name="find_in_page">Find in page</string>
    <string name="menu_ping">Ping test</string>
    <string name="menu_private_dns">Private DNS settings</string>
    <string name="menu_settings">Settings</string>
    <string name="no_app_for_action">No app on this phone can open that.</string>

    <!-- Find bar -->
    <string name="find_previous">Previous match</string>
    <string name="find_next">Next match</string>
    <string name="find_close">Close find in page</string>

    <!-- Account menu -->
    <string name="account_number">Account %1$d</string>
    <string name="unload_account">Unload %1$s</string>
    <string name="account_loaded">loaded</string>
    <string name="current_account">current</string>
    <string name="desktop_site">Desktop site</string>
    <string name="reload_page">Reload page</string>
    <string name="hide_status_bar">Hide status bar</string>
    <string name="clear_cache">Clear cache</string>
    <string name="cache_cleared">Cache cleared. Logins stay.</string>
    <string name="manage_accounts">Manage accounts</string>
    <string name="state_on">On</string>
    <string name="state_off">Off</string>

    <!-- Pages -->
    <string name="tab_unloaded">Unloaded. Tap to load</string>
    <string name="tab_load_failed">Couldn\'t load this page. Tap to retry</string>
    <string name="tab_gave_up">%1$s keeps crashing and was closed.</string>
    <string name="download_saved">Saved to Downloads</string>
    <string name="download_failed">This file can\'t be downloaded.</string>

    <!-- Connection status (status/ConnectionStatus; the service's name is filled in from site/Site) -->
    <string name="status_title">Connection status</string>
    <string name="status_unknown">Connection status: checking</string>
    <string name="status_secure">This phone uses %1$s over an encrypted connection.</string>
    <string name="status_insecure">This phone uses %1$s, but the connection is not encrypted.</string>
    <string name="status_other_dns">Private DNS is on, but it points to another DNS service, not %1$s.</string>
    <string name="status_not_protected">This phone is not using %1$s.</string>
    <string name="status_hint">Green = encrypted %1$s. Orange = %1$s without encryption. Yellow = another private DNS. Red = not protected.</string>
    <string name="close">Close</string>

    <!-- Ping test window -->
    <string name="ping_title">Ping test</string>
    <string name="back">Back</string>

    <!-- App lock -->
    <string name="lock_title">Unlock %1$s</string>
    <string name="lock_subtitle">Confirm it\'s you to see your DNS settings.</string>
    <string name="lock_button">Unlock</string>
    <string name="lock_locked">Locked</string>
    <string name="lock_unavailable">Set a screen lock (PIN, pattern or fingerprint) in Android\'s settings first.</string>
</resources>
